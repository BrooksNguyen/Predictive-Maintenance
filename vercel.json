{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "dashboard": {
      "root": "dashboard",
      "runtime": "python",
      "entrypoint": "app.py"
    },
    "iot_simulator": {
      "root": "iot_simulator",
      "runtime": "python",
      "entrypoint": "simulator.py"
    },
    "ml_service": {
      "root": "ml_service",
      "runtime": "python",
      "entrypoint": "inference.py"
    },
    "ml_training": {
      "root": "ml_training",
      "runtime": "python",
      "entrypoint": "train_rul_model.py"
    },
    "spark_etl": {
      "root": "spark_etl",
      "runtime": "python",
      "entrypoint": "streaming_job.py",
      "bindings": [
        {
          "type": "service",
          "service": "iot_simulator",
          "format": "url",
          "env": "IOT_SIMULATOR_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "dashboard"
      }
    }
  ]
}
