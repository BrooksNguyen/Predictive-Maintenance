{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "landing": {
      "root": "landing",
      "framework": "static"
    },
    "dashboard": {
      "root": "dashboard",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/demo/(.*)",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "landing"
      }
    }
  ]
}
